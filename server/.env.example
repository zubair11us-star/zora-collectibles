# Required: your Anthropic API key. Get one at https://console.anthropic.com/
# Never commit the real .env file — it's already in .gitignore.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: enables the /lookup-price endpoint (reference pricing search).
# Get both from Google Cloud Console + Programmable Search Engine — see
# docs/GOOGLE_SEARCH_SETUP.md. Leave unset to leave price lookup disabled;
# everything else keeps working.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional overrides
PORT=4000
CLAUDE_MODEL=claude-sonnet-5
