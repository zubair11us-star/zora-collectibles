# URL of the Zora AI proxy server (server/). The phone must be able to reach
# this address, so use your dev machine's LAN IP, not "localhost", when
# testing on a physical device via Expo Go.
# Example: http://192.168.1.42:4000
EXPO_PUBLIC_AI_SERVER_URL=http://localhost:4000

# Optional: only needed for cloud sync / accounts (Phase 3). See
# docs/SUPABASE_SETUP.md. Leave unset to use the app fully offline.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
