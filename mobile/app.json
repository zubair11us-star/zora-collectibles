{
  "expo": {
    "name": "Zura",
    "slug": "zora-collectibles",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zora.collectibles",
      "infoPlist": {
        "NSCameraUsageDescription": "Zura uses the camera to scan and identify your collectibles.",
        "NSPhotoLibraryUsageDescription": "Zura needs photo library access so you can attach existing photos to items."
      }
    },
    "android": {
      "package": "com.zora.collectibles",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1220"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Zura uses the camera to scan and identify your collectibles."
        }
      ],
      [
        "expo-sqlite"
      ],
      "expo-asset",
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "263608cb-7fc4-4fde-95de-7473aa2b00ba"
      }
    },
    "owner": "zubair_11us"
  }
}
